#include <stdio.h>
#include <string.h>
#define MAX 20
struct Patient
{
    char name[20];
    int priority;
    int order;
};
struct Patient queue[MAX];
int size = 0;
int orderCount = 0;
// Function to add a patient
void addPatient(char name[], int priority)
{
    if (size == MAX)
    {
        printf("Queue is full!\n");
        return;
    }
strcpy(queue[size].name, name);
    queue[size].priority = priority;
    queue[size].order = orderCount++;
    size++;
printf("Added: %s (Priority %d)\n", name, priority);
}
// Function to treat the next patient
void treatNext()
{
    if (size == 0)
    {
        printf("No patients waiting.\n");
        return;
    }
int index = 0;
// Find the patient with the lowest priority number
    for (int i = 1; i < size; i++)
    {
        if (queue[i].priority < queue[index].priority ||
            (queue[i].priority == queue[index].priority &&
             queue[i].order < queue[index].order))
        {
            index = i;
        }
    }
 printf("Treating: %s (Priority %d)\n",
           queue[index].name, queue[index].priority);
// Remove the treated patient
    for (int i = index; i < size - 1; i++)
    {
        queue[i] = queue[i + 1];
    }
size--;
}
int main()
{
    printf("HOSPITAL PATIENT PRIORITY QUEUE\n\n");
 // Add patients P1 to P6
    addPatient("P1", 3);
    addPatient("P2", 1);
    addPatient("P3", 2);
    addPatient("P4", 1);
    addPatient("P5", 3);
    addPatient("P6", 2);
 printf("\n--- Treatment Order ---\n");
// Treat two patients
    treatNext();
    treatNext();
 // Add a new Emergency patient
    printf("\n--- New Emergency Patient ---\n");
    addPatient("P7", 1);
printf("\n--- Remaining Treatment Order ---\n");
 // Treat remaining patients
    while (size > 0)
    {
        treatNext();
    }
return 0;
}
